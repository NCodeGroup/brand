# Normalize text to LF in the repository and in working copies.
* text=auto eol=lf

# Windows command scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.snk binary
# The fonts: fonts.lock.json and manifest.json pin their bytes.
*.woff2 binary
