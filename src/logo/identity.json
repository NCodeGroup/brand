{
  "$description": "The NCode Identity mark, {id}: the letters i and d, for identity, between the braces of the {N} mark, drawn on a 64-unit grid from straight lines and circular arcs. build.mjs draws every file in logo/identity/ from these numbers, in the colors of the blue ramp in tokens.source.json: blue.600 NCode Blue, blue.300 NCode Blue Light and blue.900 NCode Navy.",
  "$names": "name: the product the mark stands for, the title of every SVG and the web manifest's name. shortName: the web manifest's short_name. prefix: how every file's name starts. letters: what lib/logo.mjs draws between the braces, N or id. outlinesDescription: the $description of outlines.json.",
  "name": "NCode Identity",
  "shortName": "Identity",
  "prefix": "ncode-identity",
  "letters": "id",
  "$fields": "size: the square canvas. stroke: the braces' stroke. brace: x of the left brace's beak tip and of its hook ends. beakRadius: center-line radius of the two arcs into the beak. hookRadius: center-line radius of the two hooks. braceY: top and bottom of the braces. stem: the stems of the i and the d. bowl: the stroke of the d's bowl. iX: left of the i. dX: left and right of the d. letterY: top of the d, top of the i and of the bowl, and the baseline. dot: top of the i's dot, and its diameter. taper: how much thinner than the stroke the beak's tip is. beakY: the beak's center, when it isn't the middle of the brace. squareDot: the dot as a square of whole pixels. stepped: the bowl as three bars of whole pixels, its two corners cut by this many.",

  "$master": "The braces are the {N} mark's: a stroke of 4, 48 high. The letters have the same stroke: the d 16 wide and 32 high, its bowl a ring 16 across, and the i as high as the bowl under a dot of 5. 4 units clear left and right, 8 above and below.",
  "master": { "size": 64, "stroke": 4, "brace": [4, 16], "beakRadius": 6, "hookRadius": 5, "braceY": [8, 56], "taper": 2, "stem": 4, "bowl": 4, "iX": 20, "dX": [28, 44], "letterY": [16, 32, 48], "dot": [21.5, 5] },

  "$fitted": "The same drawing with every stem on whole pixels, for the sizes where half a pixel shows. Up to 24 the bowl is three bars around one hole, and up to 32 the dot is a square. At 16 the beak is half a pixel above the middle, on a row; at 20 the bowl is one pixel, which keeps its hole two pixels wide; at 32 every letter's edge is on an even pixel, so the drawing stays sharp at half its size.",
  "fitted": {
    "16": { "size": 16, "stroke": 1, "brace": [1, 4], "beakRadius": 1.5, "hookRadius": 1, "braceY": [2, 14], "beakY": 7.5, "stem": 1, "bowl": 1, "iX": 5, "dX": [7, 11], "letterY": [4, 8, 12], "dot": [6, 1], "squareDot": true, "stepped": 1 },
    "20": { "size": 20, "stroke": 2, "brace": [1, 5], "beakRadius": 2, "hookRadius": 2, "braceY": [2, 18], "stem": 2, "bowl": 1, "iX": 6, "dX": [9, 14], "letterY": [5, 9, 15], "dot": [6, 2], "squareDot": true, "stepped": 1 },
    "24": { "size": 24, "stroke": 2, "brace": [1, 5], "beakRadius": 2, "hookRadius": 2, "braceY": [3, 21], "stem": 2, "bowl": 2, "iX": 7, "dX": [11, 17], "letterY": [6, 12, 18], "dot": [8, 2], "squareDot": true, "stepped": 1 },
    "32": { "size": 32, "stroke": 2, "brace": [2, 8], "beakRadius": 3, "hookRadius": 2.5, "braceY": [4, 28], "stem": 2, "bowl": 2, "iX": 10, "dX": [14, 22], "letterY": [8, 16, 24], "dot": [12, 2], "squareDot": true },
    "40": { "size": 40, "stroke": 3, "brace": [2, 9], "beakRadius": 3.5, "hookRadius": 3.5, "braceY": [5, 35], "taper": 1, "stem": 3, "bowl": 3, "iX": 12, "dX": [18, 28], "letterY": [10, 20, 30], "dot": [13, 4] },
    "48": { "size": 48, "stroke": 3, "brace": [3, 12], "beakRadius": 4.5, "hookRadius": 3.5, "braceY": [6, 42], "taper": 1, "stem": 3, "bowl": 3, "iX": 15, "dX": [21, 33], "letterY": [12, 24, 36], "dot": [16, 4] }
